{
  "name": "vip-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "predev": "pnpm registry:build",
    "dev": "next dev",
    "prebuild": "pnpm registry:build",
    "build": "next build",
    "palette:build": "node scripts/generate-palettes.mjs && biome format --write src/lib/palette-data.ts",
    "registry:build": "node scripts/generate-registry.mjs && biome format --write public/r registry.json",
    "test:registry": "node --test \"scripts/*.test.mjs\"",
    "test:registry:cli": "node scripts/test-registry-cli.mjs",
    "test:a11y": "node scripts/axe-a11y.mjs",
    "test:dialog": "playwright test tests/dialog.spec.ts",
    "seo:audit": "node scripts/seo-audit.mjs",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/charts": "^1.5.0",
    "@tanstack/highlight": "^1.2.12",
    "@tanstack/react-table": "^9.3.1",
    "@vercel/analytics": "^2.0.1",
    "@zag-js/react": "^1.47.0",
    "@zag-js/scroll-area": "^1.47.0",
    "d3-geo": "^3.1.2",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "geist": "1.9.2",
    "motion": "^14.12.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "tailwind-variants": "^4.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-react-aria-components": "^2.2.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.14.0",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
