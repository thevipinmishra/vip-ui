{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "base",
  "type": "registry:base",
  "title": "Base",
  "description": "Sets up a project with the vip/ui theme, the shadow tokens, and the easing tokens.",
  "author": "thevipinmishra <https://github.com/thevipinmishra>",
  "categories": ["setup"],
  "docs": "Run after shadcn init and before a theme item. The base sets the sage theme colors, the shadow and easing tokens, and the Tailwind React Aria plugin. A theme item installed after it replaces the colors.",
  "dependencies": ["tailwindcss-react-aria-components@^2.2.0"],
  "files": [],
  "cssVars": {
    "theme": {
      "color-background": "var(--background)",
      "color-foreground": "var(--foreground)",
      "color-card": "var(--card)",
      "color-card-foreground": "var(--card-foreground)",
      "color-popover": "var(--popover)",
      "color-popover-foreground": "var(--popover-foreground)",
      "color-primary": "var(--primary)",
      "color-primary-foreground": "var(--primary-foreground)",
      "color-secondary": "var(--secondary)",
      "color-secondary-foreground": "var(--secondary-foreground)",
      "color-muted": "var(--muted)",
      "color-muted-foreground": "var(--muted-foreground)",
      "color-accent": "var(--accent)",
      "color-accent-foreground": "var(--accent-foreground)",
      "color-highlight": "var(--highlight)",
      "color-destructive": "var(--destructive)",
      "color-destructive-foreground": "var(--destructive-foreground)",
      "color-border": "var(--border)",
      "color-input": "var(--input)",
      "color-ring": "var(--ring)",
      "color-success": "var(--success)",
      "color-success-subtle": "var(--success-subtle)",
      "color-success-foreground": "var(--success-foreground)",
      "color-warning": "var(--warning)",
      "color-warning-subtle": "var(--warning-subtle)",
      "color-warning-foreground": "var(--warning-foreground)",
      "color-chart-1": "var(--chart-1)",
      "color-chart-2": "var(--chart-2)",
      "color-chart-3": "var(--chart-3)",
      "color-chart-4": "var(--chart-4)",
      "color-chart-5": "var(--chart-5)",
      "color-chart-6": "var(--chart-6)",
      "ease-out-quint": "cubic-bezier(0.23, 1, 0.32, 1)",
      "ease-spring": "linear(0, 0.1251, 0.3554, 0.5737, 0.7411, 0.8551, 0.9259, 0.9666, 0.988, 0.9981, 1.002, 1)"
    },
    "light": {
      "background": "#f7f9f8",
      "foreground": "#1a211e",
      "card": "#fff",
      "card-foreground": "#1a211e",
      "popover": "#fff",
      "popover-foreground": "#1a211e",
      "primary": "#1a211e",
      "primary-foreground": "#fbfdfc",
      "secondary": "#eef1f0",
      "secondary-foreground": "#1a211e",
      "muted": "#eef1f0",
      "muted-foreground": "#5f6563",
      "accent": "#e6e9e8",
      "accent-foreground": "#1a211e",
      "highlight": "color-mix(in oklab, var(--foreground) 6%, transparent)",
      "destructive": "oklch(0.535 0.19 26)",
      "destructive-foreground": "#fbfdfc",
      "border": "#d7dad9",
      "input": "#cbcfcd",
      "ring": "#7c8481",
      "success": "oklch(0.43 0.12 155)",
      "success-subtle": "oklch(0.955 0.035 155)",
      "success-foreground": "oklch(0.32 0.09 155)",
      "warning": "oklch(0.54 0.13 75)",
      "warning-subtle": "oklch(0.965 0.045 85)",
      "warning-foreground": "oklch(0.36 0.09 75)",
      "chart-1": "#1a211e",
      "chart-2": "oklch(0.62 0.11 180)",
      "chart-3": "oklch(0.63 0.13 75)",
      "chart-4": "oklch(0.56 0.14 320)",
      "chart-5": "oklch(0.48 0.13 32)",
      "chart-6": "oklch(0.43 0.12 280)",
      "shadow-card": "0 1px 2px -1px oklch(0 0 0 / 0.08), 0 3px 8px -4px oklch(0 0 0 / 0.07)",
      "shadow-float": "0 2px 4px -2px oklch(0 0 0 / 0.1), 0 8px 18px -9px oklch(0 0 0 / 0.11)",
      "shadow-inset": "inset 0 1px 2px oklch(0 0 0 / 0.045)"
    },
    "dark": {
      "background": "#101211",
      "foreground": "#eceeed",
      "card": "#171918",
      "card-foreground": "#eceeed",
      "popover": "#202221",
      "popover-foreground": "#eceeed",
      "primary": "#eceeed",
      "primary-foreground": "#101211",
      "secondary": "#272a29",
      "secondary-foreground": "#eceeed",
      "muted": "#272a29",
      "muted-foreground": "#adb5b2",
      "accent": "#2e3130",
      "accent-foreground": "#eceeed",
      "highlight": "color-mix(in oklab, var(--foreground) 6%, transparent)",
      "destructive": "oklch(0.67 0.16 26)",
      "destructive-foreground": "#101211",
      "border": "#373b39",
      "input": "#444947",
      "ring": "#717d79",
      "success": "oklch(0.74 0.13 155)",
      "success-subtle": "oklch(0.24 0.045 155)",
      "success-foreground": "oklch(0.86 0.085 155)",
      "warning": "oklch(0.78 0.11 75)",
      "warning-subtle": "oklch(0.27 0.045 75)",
      "warning-foreground": "oklch(0.89 0.07 75)",
      "chart-1": "#adb5b2",
      "chart-2": "oklch(0.63 0.11 180)",
      "chart-3": "oklch(0.66 0.13 85)",
      "chart-4": "oklch(0.53 0.15 320)",
      "chart-5": "oklch(0.56 0.15 27)",
      "chart-6": "oklch(0.66 0.12 280)",
      "shadow-card": "0 1px 2px -1px oklch(0 0 0 / 0.24), 0 3px 8px -4px oklch(0 0 0 / 0.25)",
      "shadow-float": "0 2px 4px -2px oklch(0 0 0 / 0.3), 0 8px 18px -9px oklch(0 0 0 / 0.34)",
      "shadow-inset": "inset 0 1px 2px oklch(0 0 0 / 0.15)"
    }
  },
  "css": {
    "@plugin tailwindcss-react-aria-components": {}
  }
}
