{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "vip-billing-01",
  "type": "registry:block",
  "title": "Billing 01",
  "description": "A plan picker with usage meters and a payment method.",
  "categories": ["settings"],
  "dependencies": ["@phosphor-icons/react@^2.1.10"],
  "registryDependencies": [
    "https://vip-ui.dev/r/vip-badge.json",
    "https://vip-ui.dev/r/vip-button.json",
    "https://vip-ui.dev/r/vip-card.json",
    "https://vip-ui.dev/r/vip-meter.json",
    "https://vip-ui.dev/r/vip-radio-group.json"
  ],
  "files": [
    {
      "path": "src/app/blocks/billing-01/billing-settings.tsx",
      "type": "registry:file",
      "target": "src/app/blocks/billing-01/billing-settings.tsx",
      "content": "\"use client\";\n\nimport { CreditCardIcon, DownloadSimpleIcon } from \"@phosphor-icons/react\";\nimport { useState } from \"react\";\nimport { Badge } from \"../../../components/vip-ui/badge\";\nimport { Button } from \"../../../components/vip-ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardFooter,\n  CardHeader,\n  CardTitle,\n} from \"../../../components/vip-ui/card\";\nimport { Meter } from \"../../../components/vip-ui/meter\";\nimport {\n  RadioButton,\n  RadioDescription,\n  RadioField,\n  RadioGroup,\n  RadioIndicator,\n  RadioLabel,\n} from \"../../../components/vip-ui/radio-group\";\n\nconst plans = [\n  {\n    id: \"starter\",\n    name: \"Starter\",\n    price: 0,\n    description: \"3 seats and 10 GB of storage\",\n  },\n  {\n    id: \"pro\",\n    name: \"Pro\",\n    price: 24,\n    description: \"10 seats and 100 GB of storage\",\n  },\n  {\n    id: \"business\",\n    name: \"Business\",\n    price: 59,\n    description: \"50 seats, 1 TB of storage, and SSO\",\n  },\n];\n\nconst usage = [\n  { label: \"Seats\", value: 8, max: 10, unit: \"seats\" },\n  { label: \"Storage\", value: 42, max: 100, unit: \"GB\" },\n  { label: \"API requests\", value: 74, max: 100, unit: \"thousand\" },\n];\n\nconst invoices = [\n  { id: \"INV-0042\", date: \"Oct 1, 2026\", amount: \"$24.00\" },\n  { id: \"INV-0037\", date: \"Sep 1, 2026\", amount: \"$24.00\" },\n  { id: \"INV-0031\", date: \"Aug 1, 2026\", amount: \"$24.00\" },\n];\n\nexport function BillingSettings() {\n  const [current, setCurrent] = useState(\"pro\");\n  const [selected, setSelected] = useState(\"pro\");\n  const plan = plans.find((item) => item.id === current) ?? plans[0];\n  const changed = selected !== current;\n\n  return (\n    <div className=\"grid gap-6\">\n      <div>\n        <h1 className=\"text-2xl font-semibold tracking-[-0.04em]\">Billing</h1>\n        <p className=\"mt-1 text-sm text-muted-foreground\">\n          Manage your plan, usage, and payment details.\n        </p>\n      </div>\n      <div className=\"grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,20rem)]\">\n        <Card>\n          <CardHeader>\n            <CardTitle as=\"h2\">Plan</CardTitle>\n            <CardDescription>\n              You use the {plan.name} plan. It renews on November 1.\n            </CardDescription>\n          </CardHeader>\n          <CardContent>\n            <RadioGroup\n              aria-label=\"Plan\"\n              value={selected}\n              onChange={setSelected}\n              className=\"gap-2\"\n            >\n              {plans.map((item) => (\n                <RadioField key={item.id} value={item.id} variant=\"card\">\n                  <RadioButton>\n                    <RadioIndicator />\n                    <RadioLabel className=\"flex flex-1 flex-wrap items-center gap-2\">\n                      {item.name}\n                      {item.id === current && (\n                        <Badge variant=\"accent\" className=\"min-h-5 py-0\">\n                          Current\n                        </Badge>\n                      )}\n                    </RadioLabel>\n                    <span className=\"font-semibold tabular-nums\">\n                      ${item.price}\n                      <span\n                        aria-hidden=\"true\"\n                        className=\"font-normal text-muted-foreground\"\n                      >\n                        /mo\n                      </span>\n                      <span className=\"sr-only\"> per month</span>\n                    </span>\n                  </RadioButton>\n                  <RadioDescription>{item.description}</RadioDescription>\n                </RadioField>\n              ))}\n            </RadioGroup>\n          </CardContent>\n          <CardFooter className=\"justify-end border-t border-border/70 pt-5\">\n            <Button\n              variant=\"ghost\"\n              isDisabled={!changed}\n              onPress={() => setSelected(current)}\n            >\n              Cancel\n            </Button>\n            <Button isDisabled={!changed} onPress={() => setCurrent(selected)}>\n              Change plan\n            </Button>\n          </CardFooter>\n        </Card>\n        <div className=\"grid content-start gap-6\">\n          <Card>\n            <CardHeader>\n              <CardTitle as=\"h2\">Usage</CardTitle>\n              <CardDescription>This billing period</CardDescription>\n            </CardHeader>\n            <CardContent className=\"grid gap-4\">\n              {usage.map((item) => (\n                <Meter\n                  key={item.label}\n                  label={item.label}\n                  value={item.value}\n                  maxValue={item.max}\n                  valueLabel={`${item.value} of ${item.max} ${item.unit}`}\n                  className=\"[&_[data-slot=meter-value]]:text-xs\"\n                />\n              ))}\n            </CardContent>\n          </Card>\n          <Card>\n            <CardHeader>\n              <CardTitle as=\"h2\">Payment method</CardTitle>\n            </CardHeader>\n            <CardContent className=\"flex items-center gap-3\">\n              <span className=\"grid size-10 place-items-center rounded-md bg-muted ring-1 ring-border/70\">\n                <CreditCardIcon size={20} aria-hidden=\"true\" />\n              </span>\n              <div className=\"min-w-0 flex-1 text-sm\">\n                <p className=\"font-medium\">Visa ending in 4242</p>\n                <p className=\"text-xs text-muted-foreground\">Expires 08/2028</p>\n              </div>\n              <Button variant=\"outline\" size=\"sm\">\n                Update\n              </Button>\n            </CardContent>\n          </Card>\n        </div>\n      </div>\n      <Card>\n        <CardHeader>\n          <CardTitle as=\"h2\">Invoices</CardTitle>\n        </CardHeader>\n        <CardContent className=\"pt-3\">\n          <ul className=\"divide-y divide-border/70\">\n            {invoices.map((invoice) => (\n              <li\n                key={invoice.id}\n                className=\"flex flex-wrap items-center gap-x-4 gap-y-1 py-3 text-sm\"\n              >\n                <span className=\"font-mono text-xs text-muted-foreground\">\n                  {invoice.id}\n                </span>\n                <span className=\"flex-1\">{invoice.date}</span>\n                <Badge variant=\"success\">Paid</Badge>\n                <span className=\"w-16 text-end font-medium tabular-nums\">\n                  {invoice.amount}\n                </span>\n                <Button\n                  variant=\"ghost\"\n                  iconOnly\n                  aria-label={`Download ${invoice.id}`}\n                  className=\"size-9\"\n                >\n                  <DownloadSimpleIcon size={17} aria-hidden=\"true\" />\n                </Button>\n              </li>\n            ))}\n          </ul>\n        </CardContent>\n      </Card>\n    </div>\n  );\n}\n"
    },
    {
      "path": "src/app/blocks/billing-01/page.tsx",
      "type": "registry:page",
      "target": "src/app/blocks/billing-01/page.tsx",
      "content": "import type { Metadata } from \"next\";\nimport { BillingSettings } from \"./billing-settings\";\n\nexport const metadata: Metadata = {\n  title: \"Billing\",\n};\n\nexport default function BillingPage() {\n  return (\n    <main className=\"min-h-svh bg-background px-5 py-10 sm:px-8\">\n      <div className=\"mx-auto max-w-4xl\">\n        <BillingSettings />\n      </div>\n    </main>\n  );\n}\n"
    }
  ]
}
