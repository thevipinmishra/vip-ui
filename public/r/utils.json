{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "utils",
  "type": "registry:lib",
  "title": "Utils",
  "description": "Merges class names with tailwind-variants.",
  "author": "thevipinmishra <https://github.com/thevipinmishra>",
  "categories": ["shared"],
  "dependencies": ["tailwind-variants@^4.0.2"],
  "files": [
    {
      "path": "src/lib/utils.ts",
      "type": "registry:file",
      "target": "@components/vip-ui/utils.ts",
      "content": "import { type CnOptions, cn as mergeClasses } from \"tailwind-variants\";\n\nexport function cn(...classes: CnOptions): string {\n  return mergeClasses(...classes) ?? \"\";\n}\n"
    }
  ]
}
