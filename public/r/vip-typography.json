      },
      ":where(.typography) :where(h2):not(:where(.not-typography, .not-typography *, [data-not-typography], [data-not-typography] *))": {
        "font-size": "1.5em",
        "line-height": "calc(var(--typography-leading) * 0.75)",
        "letter-spacing": "-0.03em"
