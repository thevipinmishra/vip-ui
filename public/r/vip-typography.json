        "--typography-font-mono": "var(--font-mono, ui-monospace, monospace)",
        "--typography-size": "1em",
        "--typography-leading": "1.75",
        "--typography-flow": "1.25em",
        "font-family": "var(--typography-font-body)",
        "font-size": "var(--typography-size)",
        "line-height": "var(--typography-leading)",
        "color": "var(--foreground)",
        "overflow-wrap": "break-word"
      },
      "@media (width < 40rem)": {
        ".typography": {
          "font-size": "calc(var(--typography-size) * 1.0625)"
        }
      },
      ":where(.typography) :where(* + :is(p, ul, ol, dl, pre, blockquote, figure, table, details, div, section, aside, img, video, iframe)):not(:where(:is(h1, h2, h3, h4, h5, h6, hr, summary, .markdown-alert-title) + *, .not-typography *, [data-not-typography] *))": {
        "margin-block-start": "var(--typography-flow)"
