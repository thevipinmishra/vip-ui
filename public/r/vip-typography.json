        "margin-block-start": "calc(var(--typography-flow) * 1.4)"
      },
      ":where(.typography) :where(* + :is(h4, h5, h6)):not(:where(:is(h1, h2, h3, h4, h5, h6, hr, summary) + *, .not-typography *, [data-not-typography] *))": {
        "margin-block-start": "calc(var(--typography-flow) * 1.2)"
      },
      ":where(.typography) :where(:is(h1, h2, h3, h4, h5, h6):not(.sr-only) + *):not(:where(hr, .not-typography *, [data-not-typography] *))": {
